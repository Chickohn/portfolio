# Next.js Environment Variables
# Copy this file to .env.local and fill in your values

# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=

# Site URL (for SEO and structured data)
NEXT_PUBLIC_SITE_URL=https://kohn.me.uk

# ----------------------------
# Sanity (projects database)
# ----------------------------
# These are safe to expose to the browser (Sanity project + dataset identifiers)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Optional API version for Sanity client (defaults in code if unset)
SANITY_API_VERSION=

# Read token (optional; required if your dataset is private)
SANITY_API_READ_TOKEN=

# Write token (server-only; NEVER expose to browser)
SANITY_API_WRITE_TOKEN=

# Once migration is confirmed, disable fallback to hard-coded project data
# SANITY_DISABLE_FALLBACK=true

# ----------------------------
# Admin authentication (Auth.js / NextAuth)
# ----------------------------
# Admin allowlist + password (server-only)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# NextAuth config (required for production)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# ----------------------------
# Optional on-demand revalidation
# ----------------------------
# Secret for POST /api/revalidate (header: x-revalidate-secret)
REVALIDATE_SECRET=

# ----------------------------
# Victoria private area
# ----------------------------
# Server-only pooled Postgres URL. Use a managed provider suitable for Vercel.
DATABASE_URL=

# Server-only secrets. Generate with: openssl rand -base64 48
VICTORIA_SESSION_SECRET=
VICTORIA_TOKEN_HASH_SECRET=

# Defaults keep /victoria disabled on Vercel preview deployments.
VICTORIA_FEATURE_ENABLED=
VICTORIA_ALLOWED_HOSTS=kohn.me.uk,localhost,127.0.0.1
# Local-only claim-link bypass (Freddie/Victoria buttons on /victoria/access).
# On by default in `next dev`. Hard-blocked on kohn.me.uk and Vercel production.
# Set to "true" for local `next start`, or "false" to disable even in development.
VICTORIA_DEV_BYPASS=
VICTORIA_SESSION_DAYS=90
VICTORIA_ANALYTICS_RETENTION_DAYS=180
VICTORIA_UPLOAD_MAX_BYTES=10485760

# Ably realtime. Never expose VICTORIA_ABLY_API_KEY.
VICTORIA_ABLY_API_KEY=

# Supabase private storage bucket. Service role key is server-only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VICTORIA_STORAGE_BUCKET=victoria-private

# Optional managed rate-limit proxy. If unset, requests are allowed and noted as degraded.
VICTORIA_RATE_LIMIT_URL=
VICTORIA_RATE_LIMIT_TOKEN=

# Node Environment
# NODE_ENV=production
